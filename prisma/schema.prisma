// TABLAS LEGACY (introspectadas desde la BD real via `prisma db pull`)
// ----------------------------------------------------------------------------
// Todo lo que sigue hasta la marca "TABLAS NUEVAS DE ESTA APP" ya existia en
// la base de datos antes de este proyecto. NO se altera ninguna de estas
// tablas desde aqui: solo se leen/referencian. `user`/`session`/`account`/
// `verification`/`twoFactor` son el esquema de better-auth (login legacy);
// el resto son las tablas de negocio del ERP que se va a reemplazar.
//
// `user.role` y `user.permissions` (texto plano) son del sistema legacy y NO
// se usan para autorizar nada en esta app nueva: el RBAC de esta app vive por
// completo en las tablas nuevas de abajo (Rol/Permiso/RolPermiso/UsuarioRol).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model account {
  id                    String    @id @db.VarChar(36)
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String    @db.VarChar(36)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.Timestamp(3)
  refreshTokenExpiresAt DateTime? @db.Timestamp(3)
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @db.Timestamp(3)
  updatedAt             DateTime  @db.Timestamp(3)
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "account_ibfk_1")

  @@index([userId])
}

