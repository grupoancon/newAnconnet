// ============================================================================
// TABLAS NUEVAS DE ESTA APP (fase 0 — cimientos)
// ----------------------------------------------------------------------------
// La identidad del usuario sigue viviendo en la tabla legacy `user` (arriba):
// no se crea una tabla "Usuario" separada. Todo lo de aqui es 100% aditivo,
// mapeado con @@map(..._app) para no chocar nunca con nombres de tablas legacy.
// El login es solo el de better-auth (anconAPI) — el login propio que tenia esta
// app (modelos CredencialAcceso/Sesion, tablas credenciales_acceso/sesiones_app) se
// quito; esas tablas pueden seguir existiendo en la base, ya sin uso.
// ============================================================================

model Rol {
  id          String   @id @default(cuid())
  nombre      String   @unique
  descripcion String?
  createdAt   DateTime @default(now())

  usuarios UsuarioRol[]
  permisos RolPermiso[]

  @@map("roles_app")
}

// Tabla puente user<->Rol. Un usuario puede tener mas de un rol.
model UsuarioRol {
  usuarioId String @db.VarChar(36)
  rolId     String

  usuario user @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol     Rol  @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rolId])
  @@map("usuarios_roles_app")
}

// Permiso = accion posible sobre un recurso de negocio (ej. recurso "lote", accion "aprobar").
// Los recursos no tienen modelo propio todavia: son solo strings hasta que se construya el modulo real.
model Permiso {
  id      String @id @default(cuid())
  recurso String
  accion  String

  roles     RolPermiso[]
  usuarios  UsuarioPermiso[]

  @@unique([recurso, accion])
  @@map("permisos_app")
}

// Tabla puente Rol<->Permiso.
model RolPermiso {
  rolId     String
  permisoId String

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("roles_permisos_app")
}

// Override por usuario: concede o deniega un permiso puntual, aparte de sus roles.
// `modo` = "conceder" (se suma aunque ningun rol lo de) o "denegar" (se resta aunque un
// rol lo diera). El string plano compilado = (union de roles) + concedidos - denegados.
model UsuarioPermiso {
  usuarioId String @db.VarChar(36)
  permisoId String
  modo      String @db.VarChar(16)

  usuario user    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, permisoId])
  @@map("usuarios_permisos_app")
}



// Modo mantenimiento de la intranet: una sola fila (id = 1) que se edita desde
// /configuracion/mantenimiento. `modo` = "aviso" (banner arriba, se puede seguir
// trabajando) o "bloqueo" (pantalla de mantenimiento para todos menos Administrador).
// La tabla se crea a mano — ver prisma/sql/mantenimiento_app.sql.
model Mantenimiento {
  id               Int      @id @default(1)
  activo           Boolean  @default(false)
  modo             String   @default("aviso") @db.VarChar(16)
  mensaje          String?  @db.Text
  actualizadoPorId String?  @db.VarChar(36)
  actualizadoPor   String?  @db.VarChar(191)
  updatedAt        DateTime @default(now()) @updatedAt

  @@map("mantenimiento_app")
}
