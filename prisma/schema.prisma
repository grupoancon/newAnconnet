  user_sale_process_userTouser                  user?                @relation("sale_process_userTouser", fields: [user], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "sale_process_ibfk_1")
  user_sale_process_user_payment_approvedTouser user?                @relation("sale_process_user_payment_approvedTouser", fields: [user_payment_approved], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "sale_process_ibfk_2")
